{
  "name": "judge-gym",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.1.27",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev --filter=@judge-gym/engine-convex --filter=@judge-gym/lab",
    "build": "turbo build",
    "test": "turbo test",
    "pilot:smoke": "cd apps/engine-convex && bun run pilot:smoke",
    "v3:init": "cd apps/engine-convex && bun run v3:init",
    "v4:fetch:gilardi": "bun scripts/v4/fetch_gilardi.ts",
    "v4:fetch:zheng": "bun scripts/v4/fetch_zheng.ts",
    "v4:build:gilardi": "bun scripts/v4/build_gilardi_import.ts",
    "v4:build:zheng": "bun scripts/v4/build_zheng_import.ts",
    "v4:build:headline": "bun scripts/v4/build_headline_bundles.ts",
    "v4:cleanup:catalog": "bun scripts/v4/cleanup_catalog_duplicates.ts",
    "v4:inventory": "bun scripts/v4/export_inventory.ts",
    "v4:build:native": "bun scripts/v4/build_native_conceptual_manifest.ts",
    "v4:launch:native": "bun scripts/v4/launch_native_conceptual_matrix.ts",
    "v4:build:native-openai": "bun scripts/v4/build_native_openai_scale_manifests.ts",
    "v4:launch:native-openai": "bun scripts/v4/launch_native_openai_scale.ts",
    "v4:build:native-openrouter": "bun scripts/v4/build_native_openrouter_scale_manifests.ts",
    "v4:launch:native-openrouter": "bun scripts/v4/launch_native_openrouter_scale.ts",
    "v4:canary:gilardi": "bun scripts/v4/canary_gilardi.ts",
    "v4:canary:zheng": "bun scripts/v4/canary_zheng.ts",
    "v4:launch:headline": "bun scripts/v4/launch_headline_matrix.ts",
    "infra:verify:railway": "bash scripts/verify_railway_worker.sh",
    "infra:smoke:acquisition": "bun scripts/acquisition_smoke.ts",
    "typecheck": "turbo run typecheck",
    "validate:convex": "(cd apps/engine-convex && npx convex codegen) && bun run typecheck"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "convex": "^1.32.0",
    "turbo": "^2.8.10",
    "typescript": "^5.9.3"
  },
  "module": "index.ts"
}
